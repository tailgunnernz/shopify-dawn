{% doc %}
  @prompt
    A magazine-style editorial layout

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-editorial-layout-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
    padding: {{ block.settings.section_padding }}px;
    background-color: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
  }

  .ai-editorial-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: {{ block.settings.grid_gap }}px;
    margin-bottom: {{ block.settings.content_spacing }}px;
  }

  .ai-editorial-main-article-{{ ai_gen_id }} {
    position: relative;
  }

  .ai-editorial-main-image-{{ ai_gen_id }} {
    width: 100%;
    height: {{ block.settings.main_image_height }}px;
    object-fit: cover;
    border-radius: {{ block.settings.image_border_radius }}px;
    margin-bottom: {{ block.settings.content_spacing }}px;
  }

  .ai-editorial-main-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: {{ block.settings.main_image_height }}px;
    background-color: #f4f4f4;
    border-radius: {{ block.settings.image_border_radius }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: {{ block.settings.content_spacing }}px;
    position: relative;
  }

  .ai-editorial-main-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 200px;
    max-height: 200px;
  }

  .ai-editorial-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-editorial-category-{{ ai_gen_id }} {
    display: inline-block;
    background-color: {{ block.settings.category_bg_color }};
    color: {{ block.settings.category_text_color }};
    padding: 6px 12px;
    border-radius: {{ block.settings.category_border_radius }}px;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 16px;
  }

  .ai-editorial-main-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.main_title_size }}px;
    font-weight: 700;
    line-height: 1.2;
    margin: 0 0 16px;
    color: {{ block.settings.title_color }};
  }

  .ai-editorial-main-excerpt-{{ ai_gen_id }} {
    font-size: {{ block.settings.excerpt_size }}px;
    line-height: 1.6;
    margin-bottom: 20px;
    color: {{ block.settings.excerpt_color }};
  }

  .ai-editorial-meta-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 16px;
    font-size: 14px;
    color: {{ block.settings.meta_color }};margin-bottom: 20px;
  }

  .ai-editorial-author-{{ ai_gen_id }} {
    font-weight: 500;
  }

  .ai-editorial-date-{{ ai_gen_id }} {
    opacity: 0.8;
  }

  .ai-editorial-read-more-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: {{ block.settings.link_color }};
    text-decoration: none;
    font-weight: 500;
    transition: color 0.3s ease;
  }

  .ai-editorial-read-more-{{ ai_gen_id }}:hover {
    color: {{ block.settings.link_hover_color }};
  }

  .ai-editorial-sidebar-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.sidebar_spacing }}px;
  }

  .ai-editorial-sidebar-article-{{ ai_gen_id }} {
    display: flex;
    gap: 16px;
    padding-bottom: {{ block.settings.sidebar_spacing }}px;
    border-bottom: 1px solid {{ block.settings.border_color }};
  }

  .ai-editorial-sidebar-article-{{ ai_gen_id }}:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .ai-editorial-sidebar-image-{{ ai_gen_id }} {
    width: 80px;
    height: 80px;
    object-fit: cover;
    border-radius: {{ block.settings.sidebar_image_radius }}px;
    flex-shrink: 0;
  }

  .ai-editorial-sidebar-image-placeholder-{{ ai_gen_id }} {
    width: 80px;
    height: 80px;
    background-color: #f4f4f4;
    border-radius: {{ block.settings.sidebar_image_radius }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .ai-editorial-sidebar-image-placeholder-{{ ai_gen_id }} svg {
    width: 40px;
    height: 40px;
  }

  .ai-editorial-sidebar-content-{{ ai_gen_id }} {
    flex: 1;
    min-width: 0;
  }

  .ai-editorial-sidebar-category-{{ ai_gen_id }} {
    display: inline-block;
    background-color: {{ block.settings.sidebar_category_bg }};
    color: {{ block.settings.sidebar_category_text }};
    padding: 3px 8px;
    border-radius: 12px;
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.3px;
    margin-bottom: 8px;
  }

  .ai-editorial-sidebar-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.sidebar_title_size }}px;
    font-weight: 600;
    line-height: 1.3;
    margin: 0 0 8px;
    color: {{ block.settings.title_color }};
  }

  .ai-editorial-sidebar-meta-{{ ai_gen_id }} {
    font-size: 12px;
    color: {{ block.settings.meta_color }};
    opacity: 0.8;
  }

  .ai-editorial-divider-{{ ai_gen_id }} {
    width: 100%;
    height: 1px;
    background-color: {{ block.settings.border_color }};
    margin: {{ block.settings.section_spacing }}px 0;
  }

  @media screen and (max-width: 768px) {
    .ai-editorial-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;gap: {{ block.settings.mobile_spacing }}px;
    }

    .ai-editorial-main-image-{{ ai_gen_id }},
    .ai-editorial-main-image-placeholder-{{ ai_gen_id }} {
      height: {{ block.settings.mobile_image_height }}px;
    }

    .ai-editorial-main-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.main_title_size | times: 0.8 }}px;
    }

    .ai-editorial-sidebar-{{ ai_gen_id }} {
      gap: {{ block.settings.mobile_spacing }}px;
    }

    .ai-editorial-sidebar-article-{{ ai_gen_id }} {
      padding-bottom: {{ block.settings.mobile_spacing }}px;
    }
  }

  @media screen and (max-width: 480px) {
    .ai-editorial-layout-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding | times: 0.5 }}px;
    }

    .ai-editorial-meta-{{ ai_gen_id }} {
      flex-direction: column;
      align-items: flex-start;gap: 8px;
    }

    .ai-editorial-sidebar-article-{{ ai_gen_id }} {
      flex-direction: column;
      gap: 12px;
    }

    .ai-editorial-sidebar-image-{{ ai_gen_id }},
    .ai-editorial-sidebar-image-placeholder-{{ ai_gen_id }} {
      width: 100%;
      height: 120px;
    }
  }
{% endstyle %}<div class="ai-editorial-layout-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-editorial-grid-{{ ai_gen_id }}">
    <article class="ai-editorial-main-article-{{ ai_gen_id }}">
      {% if block.settings.main_image %}
        <img
          src="{{ block.settings.main_image | image_url: width: 800 }}"
          alt="{{ block.settings.main_image.alt | escape }}"
          class="ai-editorial-main-image-{{ ai_gen_id }}"
          loading="lazy"
          width="{{ block.settings.main_image.width }}"
          height="{{ block.settings.main_image.height }}"
        >
      {% else %}
        <div class="ai-editorial-main-image-placeholder-{{ ai_gen_id }}">
          {{ 'hero-apparel-1' | placeholder_svg_tag }}
          <div class="ai-editorial-empty-state-{{ ai_gen_id }}">
            Add a featured image
          </div>
        </div>
      {% endif %}

      {% if block.settings.main_category != blank %}
        <span class="ai-editorial-category-{{ ai_gen_id }}">{{ block.settings.main_category }}</span>
      {% endif %}

      {% if block.settings.main_title != blank %}
        <h1 class="ai-editorial-main-title-{{ ai_gen_id }}">{{ block.settings.main_title }}</h1>
      {% endif %}

      {% if block.settings.main_excerpt != blank %}
        <div class="ai-editorial-main-excerpt-{{ ai_gen_id }}">{{ block.settings.main_excerpt }}</div>
      {% endif %}<div class="ai-editorial-meta-{{ ai_gen_id }}">
        {% if block.settings.author != blank %}
          <span class="ai-editorial-author-{{ ai_gen_id }}">By {{ block.settings.author }}</span>
        {% endif %}
        {% if block.settings.publish_date != blank %}
          <span class="ai-editorial-date-{{ ai_gen_id }}">{{ block.settings.publish_date }}</span>
        {% endif %}</div>

      {% if block.settings.main_link != blank %}
        <a href="{{ block.settings.main_link }}" class="ai-editorial-read-more-{{ ai_gen_id }}">
          {{ block.settings.read_more_text }}<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="m9 18 6-6-6-6"/>
          </svg>
        </a>
      {% endif %}
    </article>

    <aside class="ai-editorial-sidebar-{{ ai_gen_id }}">
      {% for i in (1..3) %}
        {% liquid
          assign title_key = 'sidebar_title_' | append: i
          assign category_key = 'sidebar_category_' | append: i
          assign image_key = 'sidebar_image_' | append: i
          assign link_key = 'sidebar_link_' | append: i
          assign author_key = 'sidebar_author_' | append: i
          assign date_key = 'sidebar_date_' | append: i

          assign title = block.settings[title_key]
          assign category = block.settings[category_key]
          assign image = block.settings[image_key]
          assign link = block.settings[link_key]
          assign author = block.settings[author_key]
          assign date = block.settings[date_key]
        %}

        {% if title != blank %}
          <article class="ai-editorial-sidebar-article-{{ ai_gen_id }}">
            {% if image %}
              <img
                src="{{ image | image_url: width: 160 }}"
                alt="{{ image.alt | escape }}"
                class="ai-editorial-sidebar-image-{{ ai_gen_id }}"
                loading="lazy"
                width="{{ image.width }}"
                height="{{ image.height }}"
              >
            {% else %}
              <div class="ai-editorial-sidebar-image-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}

            <div class="ai-editorial-sidebar-content-{{ ai_gen_id }}">
              {% if category != blank %}
                <span class="ai-editorial-sidebar-category-{{ ai_gen_id }}">{{ category }}</span>
              {% endif %}

              {% if link != blank %}
                <h3 class="ai-editorial-sidebar-title-{{ ai_gen_id }}">
                  <a href="{{ link }}" style="color: inherit; text-decoration: none;">{{ title }}</a>
                </h3>
              {% else %}
                <h3 class="ai-editorial-sidebar-title-{{ ai_gen_id }}">{{ title }}</h3>
              {% endif %}

              <div class="ai-editorial-sidebar-meta-{{ ai_gen_id }}">
                {% if author != blank %}{{ author }}{% endif %}
                {% if author != blank and date != blank %} • {% endif %}
                {% if date != blank %}{{ date }}{% endif %}
              </div>
            </div>
          </article>
        {% endif %}
      {% endfor %}
    </aside>
  </div>
</div>

