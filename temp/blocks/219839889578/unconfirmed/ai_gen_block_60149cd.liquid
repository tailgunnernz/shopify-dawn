{% doc %}
  @prompt
    I need a section which will have two columns. Size of columns is able to be chosen (e.g. 50 / 50, 33 / 66 etc). Each column has heading, text, button, image and custom liquid blocks. Should be flex, so that columns can be aligned centre, start or end. And you can choose which column appears first on mobile when it stacks.

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-two-column-{{ ai_gen_id }} {
    width: 100%;
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
  }

  .ai-two-column-container-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.column_gap }}px;
    align-items: {{ block.settings.vertical_alignment }};
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-two-column-left-{{ ai_gen_id }} {
    flex: 0 0 {{ block.settings.left_column_width }}%;
  }

  .ai-two-column-right-{{ ai_gen_id }} {
    flex: 0 0 {{ 100 | minus: block.settings.left_column_width }}%;
  }

  .ai-two-column-content-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 20px;
    height: 100%;
  }

  .ai-two-column-heading-{{ ai_gen_id }} {
    margin: 0;
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    line-height: 1.2;}

  .ai-two-column-text-{{ ai_gen_id }} {
    margin: 0;
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.5;
  }

  .ai-two-column-button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 24px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: 16px;
    font-weight: 500;
    transition: background-color 0.3s ease;
    align-self: flex-start;
  }

  .ai-two-column-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
  }

  .ai-two-column-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    border-radius: {{ block.settings.image_border_radius }}px;
    overflow: hidden;
  }

  .ai-two-column-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-two-column-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 4/3;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-two-column-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 200px;
    max-height: 200px;
  }

  .ai-two-column-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 8px 16px;
    background-color: rgba(255, 255, 255, 0.9);
    border-radius: 4px;
    font-size: 12px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-two-column-liquid-{{ ai_gen_id }} {
    width: 100%;
  }

  @media screen and (max-width: 749px) {
    .ai-two-column-container-{{ ai_gen_id }} {
      flex-direction: column;
      gap: 30px;
    }

    {% if block.settings.mobile_layout == 'right_first' %}
      .ai-two-column-left-{{ ai_gen_id }} {
        order: 2;
      }
      .ai-two-column-right-{{ ai_gen_id }} {
        order: 1;
      }
    {% endif %}

    .ai-two-column-left-{{ ai_gen_id }},
    .ai-two-column-right-{{ ai_gen_id }} {
      flex: 1 1 100%;
    }

    .ai-two-column-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }
  }
{% endstyle %}

<div class="ai-two-column-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-two-column-container-{{ ai_gen_id }}">
    <div class="ai-two-column-left-{{ ai_gen_id }}">
      <div class="ai-two-column-content-{{ ai_gen_id }}">
        {% if block.settings.left_heading != blank %}
          <h2 class="ai-two-column-heading-{{ ai_gen_id }}">{{ block.settings.left_heading }}</h2>
        {% endif %}

        {% if block.settings.left_text != blank %}
          <div class="ai-two-column-text-{{ ai_gen_id }}">{{ block.settings.left_text }}</div>
        {% endif %}

        {% if block.settings.left_image %}
          <div class="ai-two-column-image-wrapper-{{ ai_gen_id }}">
            <img
              src="{{ block.settings.left_image | image_url: width: 800 }}"
              alt="{{ block.settings.left_image.alt | escape }}"
              class="ai-two-column-image-{{ ai_gen_id }}"
              loading="lazy"
              width="{{ block.settings.left_image.width }}"
              height="{{ block.settings.left_image.height }}"
            >
          </div>
        {% else %}
          <div class="ai-two-column-image-wrapper-{{ ai_gen_id }}">
            <div class="ai-two-column-image-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
              <div class="ai-two-column-empty-state-{{ ai_gen_id }}">
                Add an image for the left column
              </div>
            </div>
          </div>
        {% endif %}

        {% if block.settings.left_button_text != blank and block.settings.left_button_link != blank %}
          <a href="{{ block.settings.left_button_link }}" class="ai-two-column-button-{{ ai_gen_id }}">
            {{ block.settings.left_button_text }}
          </a>
        {% endif %}

        {% if block.settings.left_custom_liquid != blank %}
          <div class="ai-two-column-liquid-{{ ai_gen_id }}">
            {{ block.settings.left_custom_liquid }}
          </div>
        {% endif %}
      </div>
    </div>

    <div class="ai-two-column-right-{{ ai_gen_id }}">
      <div class="ai-two-column-content-{{ ai_gen_id }}">
        {% if block.settings.right_heading != blank %}
          <h2 class="ai-two-column-heading-{{ ai_gen_id }}">{{ block.settings.right_heading }}</h2>
        {% endif %}

        {% if block.settings.right_text != blank %}
          <div class="ai-two-column-text-{{ ai_gen_id }}">{{ block.settings.right_text }}</div>
        {% endif %}

        {% if block.settings.right_image %}
          <div class="ai-two-column-image-wrapper-{{ ai_gen_id }}">
            <img
              src="{{ block.settings.right_image | image_url: width: 800 }}"
              alt="{{ block.settings.right_image.alt | escape }}"
              class="ai-two-column-image-{{ ai_gen_id }}"
              loading="lazy"
              width="{{ block.settings.right_image.width }}"
              height="{{ block.settings.right_image.height }}"
            >
          </div>
        {% else %}
          <div class="ai-two-column-image-wrapper-{{ ai_gen_id }}">
            <div class="ai-two-column-image-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
              <div class="ai-two-column-empty-state-{{ ai_gen_id }}">
                Add an image for the right column
              </div>
            </div>
          </div>
        {% endif %}

        {% if block.settings.right_button_text != blank and block.settings.right_button_link != blank %}
          <a href="{{ block.settings.right_button_link }}" class="ai-two-column-button-{{ ai_gen_id }}">
            {{ block.settings.right_button_text }}
          </a>
        {% endif %}

        {% if block.settings.right_custom_liquid != blank %}
          <div class="ai-two-column-liquid-{{ ai_gen_id }}">
            {{ block.settings.right_custom_liquid }}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Two column layout",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "left_column_width",
      "min": 20,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Left column width",
      "default": 50
    },
    {
      "type": "select",
      "id": "vertical_alignment",
      "label": "Vertical alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "flex-end",
          "label": "Bottom"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile column order",
      "options": [
        {
          "value": "left_first",
          "label": "Left column first"
        },
        {
          "value": "right_first",
          "label": "Right column first"
        }
      ],
      "default": "left_first"
    },
    {
      "type": "range",
      "id": "column_gap",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Gap between columns",
      "default": 40
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 40
    },
    {
      "type": "header",
      "content": "Left column"
    },
    {
      "type": "text",
      "id": "left_heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "left_text",
      "label": "Text"
    },
    {
      "type": "image_picker",
      "id": "left_image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "left_button_text",
      "label": "Button text"
    },
    {
      "type": "url",
      "id": "left_button_link",
      "label": "Button link"
    },
    {
      "type": "liquid",
      "id": "left_custom_liquid",
      "label": "Custom Liquid"
    },
    {
      "type": "header",
      "content": "Right column"
    },
    {
      "type": "text",
      "id": "right_heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "right_text",
      "label": "Text"
    },
    {
      "type": "image_picker",
      "id": "right_image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "right_button_text",
      "label": "Button text"
    },
    {
      "type": "url",
      "id": "right_button_link",
      "label": "Button link"
    },
    {
      "type": "liquid",
      "id": "right_custom_liquid",
      "label": "Custom Liquid"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 16,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Heading size",
      "default": 32
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Text size",
      "default": 16
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#666666"
    },
    {
      "type": "header",
      "content": "Button style"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Background color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_hover_color",
      "label": "Hover background color",
      "default": "#333333"
    },
    {
      "type": "range",
      "id": "button_border_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
