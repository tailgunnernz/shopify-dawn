{% doc %}
  @prompt
    uploadery section
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-uploadery-info-{{ ai_gen_id }} {
    display: block;
    box-sizing: border-box;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: 24px;
    color: {{ block.settings.text_color }};
    background: {{ block.settings.background_color }};
    border: 1px solid rgba(18, 18, 18, 0.16);
    border-radius: 8px;
  }

  .ai-uploadery-info-{{ ai_gen_id }}__heading {
    margin: 0 0 8px;
    color: inherit;
    font-size: 1.25rem;
    line-height: 1.3;
  }

  .ai-uploadery-info-{{ ai_gen_id }}__copy {
    margin: 0;
    font-size: 1rem;
    line-height: 1.55;
  }

  .ai-uploadery-info-{{ ai_gen_id }}__copy p {
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-uploadery-info-{{ ai_gen_id }} {
      width: 100%;
      padding: 20px;
    }
  }
{% endstyle %}

<div class="ai-uploadery-info-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}
    <h2 class="ai-uploadery-info-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>
  {% endif %}
  {% if block.settings.instructions != blank %}
    <div class="ai-uploadery-info-{{ ai_gen_id }}__copy">{{ block.settings.instructions }}</div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Uploadery instructions",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Upload your artwork"
    },
    {
      "type": "richtext",
      "id": "instructions",
      "label": "Instructions",
      "default": "<p>Use the Uploadery file upload field on this product page to attach your artwork before adding the item to your cart.</p>"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#EAF6FF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#121212"
    }
  ],
  "presets": [
    {
      "name": "Uploadery instructions"
    }
  ],
  "tag": null,
  "class": "uploadery-instructions-block"
}
{% endschema %}