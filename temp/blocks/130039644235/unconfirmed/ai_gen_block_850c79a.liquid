{% doc %}
  @prompt
    an article about sustainability based on a document that I have  downloaded

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-sustainability-article-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    padding: {{ block.settings.padding }}px;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-sustainability-article__header-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
    margin-bottom:32px;
  }

  .ai-sustainability-article__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 16px 0;
    line-height: 1.2;
  }

  .ai-sustainability-article__subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.subtitle_color }};
    margin: 0 0 24px 0;
    line-height: 1.4;
  }

  .ai-sustainability-article__image-container-{{ ai_gen_id }} {
    margin-bottom: 32px;
    border-radius: {{ block.settings.image_border_radius }}px;overflow: hidden;
  }

  .ai-sustainability-article__image-container-{{ ai_gen_id }} img {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-sustainability-article__image-placeholder-{{ ai_gen_id }} {
    background-color: #f4f4f4;
    border-radius: {{ block.settings.image_border_radius }}px;
    position: relative;
    min-height: 300px;
    display: flex;
    align-items: center;
    justify-content: center;}

  .ai-sustainability-article__image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 200px;
    max-height: 200px;
    opacity: 0.3;
  }

  .ai-sustainability-article__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 14px;
    color: #666;
    text-align: center;
  }

  .ai-sustainability-article__content-{{ ai_gen_id }} {
    font-size: {{ block.settings.content_size }}px;
    color: {{ block.settings.content_color }};
    line-height: 1.6;
    margin-bottom: 32px;
  }

  .ai-sustainability-article__content-{{ ai_gen_id }} p {
    margin-bottom: 16px;
  }

  .ai-sustainability-article__content-{{ ai_gen_id }} h3 {
    font-size: {{ block.settings.content_size | times: 1.2 }}px;
    margin: 24px 0 12px 0;
    color: {{ block.settings.title_color }};
  }

  .ai-sustainability-article__document-section-{{ ai_gen_id }} {
    background-color: {{ block.settings.document_bg_color }};
    padding:24px;
    border-radius: {{ block.settings.border_radius }}px;
    border: 1px solid {{ block.settings.document_border_color }};
    margin-bottom: 32px;
  }

  .ai-sustainability-article__document-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 16px 0;
    font-weight: 600;
  }

  .ai-sustainability-article__document-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.content_size }}px;
    color: {{ block.settings.content_color }};
    margin-bottom: 20px;
    line-height: 1.5;
  }

  .ai-sustainability-article__document-link-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 24px;
    background-color: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-weight: 500;
    transition: background-color 0.3s ease;
  }

  .ai-sustainability-article__document-link-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
  }

  .ai-sustainability-article__document-icon-{{ ai_gen_id }} {
    width: 20px;
    height: 20px;
  }

  .ai-sustainability-article__stats-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 24px;
    margin-bottom: 32px;
  }

  .ai-sustainability-article__stat-{{ ai_gen_id }} {
    text-align: center;
    padding: 20px;
    background-color: {{ block.settings.stat_bg_color }};
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-sustainability-article__stat-number-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size | times: 0.8 }}px;
    font-weight: bold;
    color: {{ block.settings.stat_number_color }};
    margin-bottom: 8px;
  }

  .ai-sustainability-article__stat-label-{{ ai_gen_id }} {
    font-size: {{ block.settings.content_size }}px;
    color: {{ block.settings.content_color }};
  }

  .ai-sustainability-article__cta-section-{{ ai_gen_id }} {
    text-align: center;
    padding: 32px24px;
    background-color: {{ block.settings.cta_bg_color }};
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-sustainability-article__cta-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 12px 0;
    font-weight: 600;
  }

  .ai-sustainability-article__cta-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.content_size }}px;
    color: {{ block.settings.content_color }};
    margin-bottom: 20px;
  }

  .ai-sustainability-article__cta-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 14px 28px;
    background-color: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-weight: 500;
    transition: background-color 0.3s ease;
  }

  .ai-sustainability-article__cta-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-sustainability-article-{{ ai_gen_id }} {
      padding: {{ block.settings.padding | times: 0.7 }}px;
    }

    .ai-sustainability-article__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
    }

    .ai-sustainability-article__stats-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }
{% endstyle %}<article class="ai-sustainability-article-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <header class="ai-sustainability-article__header-{{ ai_gen_id }}">
    {% if block.settings.title != blank %}
      <h1 class="ai-sustainability-article__title-{{ ai_gen_id }}">{{ block.settings.title }}</h1>
    {% endif %}

    {% if block.settings.subtitle != blank %}
      <div class="ai-sustainability-article__subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</div>
    {% endif %}
  </header>

  {% if block.settings.featured_image %}
    <div class="ai-sustainability-article__image-container-{{ ai_gen_id }}">
      <img
        src="{{ block.settings.featured_image | image_url: width: 1200}}"
        alt="{{ block.settings.featured_image.alt | escape }}"
        loading="lazy"
        width="{{ block.settings.featured_image.width }}"
        height="{{ block.settings.featured_image.height }}"
      >
    </div>
  {% else %}
    <div class="ai-sustainability-article__image-placeholder-{{ ai_gen_id }}">
      {{ 'hero-apparel-1' | placeholder_svg_tag }}<div class="ai-sustainability-article__empty-state-{{ ai_gen_id }}">
        Add a featured image to showcase your sustainability efforts
      </div>
    </div>
  {% endif %}

  {% if block.settings.content != blank %}
    <div class="ai-sustainability-article__content-{{ ai_gen_id }}">
      {{ block.settings.content }}
    </div>
  {% endif %}

  {% if block.settings.show_stats %}
    <div class="ai-sustainability-article__stats-{{ ai_gen_id }}">
      {% if block.settings.stat_1_number != blank %}
        <div class="ai-sustainability-article__stat-{{ ai_gen_id }}">
          <div class="ai-sustainability-article__stat-number-{{ ai_gen_id }}">{{ block.settings.stat_1_number }}</div>
          <div class="ai-sustainability-article__stat-label-{{ ai_gen_id }}">{{ block.settings.stat_1_label }}</div>
        </div>
      {% endif %}

      {% if block.settings.stat_2_number != blank %}
        <div class="ai-sustainability-article__stat-{{ ai_gen_id }}">
          <div class="ai-sustainability-article__stat-number-{{ ai_gen_id }}">{{ block.settings.stat_2_number }}</div>
          <div class="ai-sustainability-article__stat-label-{{ ai_gen_id }}">{{ block.settings.stat_2_label }}</div>
        </div>
      {% endif %}

      {% if block.settings.stat_3_number != blank %}
        <div class="ai-sustainability-article__stat-{{ ai_gen_id }}">
          <div class="ai-sustainability-article__stat-number-{{ ai_gen_id }}">{{ block.settings.stat_3_number }}</div>
          <div class="ai-sustainability-article__stat-label-{{ ai_gen_id }}">{{ block.settings.stat_3_label }}</div>
        </div>
      {% endif %}
    </div>
  {% endif %}

  {% if block.settings.show_document_section %}
    <div class="ai-sustainability-article__document-section-{{ ai_gen_id }}">
      <h3 class="ai-sustainability-article__document-title-{{ ai_gen_id }}">{{ block.settings.document_title }}</h3>
      {% if block.settings.document_description != blank %}
        <div class="ai-sustainability-article__document-description-{{ ai_gen_id }}">
          {{ block.settings.document_description }}
        </div>
      {% endif %}

      {% if block.settings.document_url != blank %}
        <a href="{{ block.settings.document_url }}" class="ai-sustainability-article__document-link-{{ ai_gen_id }}" target="_blank" rel="noopener"><svg class="ai-sustainability-article__document-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <polyline points="14,2 14,8 20,8"></polyline>
            <line x1="16" y1="13" x2="8" y2="13"></line>
            <line x1="16" y1="17" x2="8" y2="17"></line>
            <polyline points="10,9 9,9 8,9"></polyline>
          </svg>
          {{ block.settings.document_link_text }}
        </a>
      {% endif %}
    </div>
  {% endif %}

  {% if block.settings.show_cta %}
    <div class="ai-sustainability-article__cta-section-{{ ai_gen_id }}">
      {% if block.settings.cta_title != blank %}
        <h3 class="ai-sustainability-article__cta-title-{{ ai_gen_id }}">{{ block.settings.cta_title }}</h3>
      {% endif %}

      {% if block.settings.cta_text != blank %}
        <div class="ai-sustainability-article__cta-text-{{ ai_gen_id }}">{{ block.settings.cta_text }}</div>
      {% endif %}

      {% if block.settings.cta_url != blank %}
        <a href="{{ block.settings.cta_url }}" class="ai-sustainability-article__cta-button-{{ ai_gen_id }}">
          {{ block.settings.cta_button_text }}
        </a>
      {% endif %}
    </div>
  {% endif %}
</article>

{% schema %}
{
  "name": "Sustainability article",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Our Commitment to Sustainability"
    },
    {
      "type": "richtext",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "<p>Learn about our environmental initiatives and how we're working towards a more sustainable future.</p>"
    },
    {
      "type": "image_picker",
      "id": "featured_image",
      "label": "Featured image"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Article content",
      "default": "<p>At our company, sustainability isn't just a buzzword—it's a core value that drives every decision we make. From sourcing materials to manufacturing processes, we're committed to reducing our environmental impact while creating products that last.</p><h3>Our Environmental Goals</h3><p>We've set ambitious targets for the coming years, including carbon neutrality, zero waste to landfill, and 100% renewable energy usage across all our facilities.</p>"
    },
    {
      "type": "header",
      "content": "Document section"
    },
    {
      "type": "checkbox",
      "id": "show_document_section",
      "label": "Show document section",
      "default": true
    },
    {
      "type": "text",
      "id": "document_title",
      "label": "Document title",
      "default": "Download Our Sustainability Report"
    },
    {
      "type": "richtext",
      "id": "document_description",
      "label": "Document description",
      "default": "<p>Get detailed insights into our environmental impact, goals, and achievements in our comprehensive sustainability report.</p>"
    },
    {
      "type": "url",
      "id": "document_url",
      "label": "Document URL"
    },
    {
      "type": "text",
      "id": "document_link_text",
      "label": "Document link text",
      "default": "Download PDF Report"
    },
    {
      "type": "header",
      "content": "Statistics"
    },
    {
      "type": "checkbox",
      "id": "show_stats",
      "label": "Show statistics",
      "default": true
    },
    {
      "type": "text",
      "id": "stat_1_number",
      "label": "Statistic 1 number",
      "default": "50%"
    },
    {
      "type": "text",
      "id": "stat_1_label",
      "label": "Statistic 1 label",
      "default": "Reduction in carbon emissions"
    },
    {
      "type": "text",
      "id": "stat_2_number",
      "label": "Statistic 2 number",
      "default": "100%"
    },
    {
      "type": "text",
      "id": "stat_2_label",
      "label": "Statistic 2 label",
      "default": "Renewable energy usage"
    },
    {
      "type": "text",
      "id": "stat_3_number",
      "label": "Statistic 3 number",
      "default": "Zero"
    },
    {
      "type": "text",
      "id": "stat_3_label",
      "label": "Statistic 3 label",
      "default": "Waste to landfill"
    },
    {
      "type": "header",
      "content": "Call to action"
    },
    {
      "type": "checkbox",
      "id": "show_cta",
      "label": "Show call to action",
      "default": true
    },
    {
      "type": "text",
      "id": "cta_title",
      "label": "CTA title",
      "default": "Join Our Mission"
    },
    {
      "type": "richtext",
      "id": "cta_text",
      "label": "CTA text",
      "default": "<p>Discover our eco-friendly products and be part of the sustainable future.</p>"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA URL"
    },
    {
      "type": "text",
      "id": "cta_button_text",
      "label": "CTA button text",
      "default": "Shop Sustainable Products"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 600,
      "max": 1200,
      "step": 50,
      "unit": "px",
      "label": "Maximum width",
      "default": 800
    },
    {
      "type": "range",
      "id": "padding",
      "min": 20,
      "max": 80,
      "step": 5,
      "unit": "px",
      "label": "Padding",
      "default": 40
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Title size",
      "default": 32
    },
    {
      "type": "range",
      "id": "subtitle_size",
      "min": 16,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Subtitle size",
      "default": 18
    },
    {
      "type": "range",
      "id": "content_size",
      "min": 14,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Content size",
      "default": 16
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#2c3e50"
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Subtitle color",
      "default": "#7f8c8d"
    },
    {
      "type": "color",
      "id": "content_color",
      "label": "Content color",
      "default": "#34495e"
    },
    {
      "type": "color",
      "id": "document_bg_color",
      "label": "Document section background",
      "default": "#f8f9fa"
    },
    {
      "type": "color",
      "id": "document_border_color",
      "label": "Document section border",
      "default": "#e9ecef"
    },
    {
      "type": "color",
      "id": "stat_bg_color",
      "label": "Statistics background",
      "default": "#f1f3f4"
    },
    {
      "type": "color",
      "id": "stat_number_color",
      "label": "Statistics number color",
      "default": "#27ae60"
    },
    {
      "type": "color",
      "id": "cta_bg_color",
      "label": "CTA background color",
      "default": "#ecf0f1"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button color",
      "default": "#27ae60"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_hover_color",
      "label": "Button hover color",
      "default": "#219a52"
    },
    {
      "type": "header",
      "content": "Border radius"
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "label": "General border radius",
      "default": 8
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "label": "Image border radius",
      "default": 12
    },
    {
      "type": "range",
      "id": "button_border_radius",
      "min": 0,
      "max": 25,
      "step": 1,
      "unit": "px",
      "label": "Button border radius",
      "default": 6
    }
  ],
  "presets": [
    {
      "name": "Sustainability article"
    }
  ],
  "tag": null
}
{% endschema %}