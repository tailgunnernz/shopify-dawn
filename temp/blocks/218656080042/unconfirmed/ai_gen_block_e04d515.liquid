{% doc %}
  @prompt
    I need a three column section for the below info. Each column would have an icon, heading and text. Should be able to change alignment.
    
    Address
    
    High Street, Clareville
    Carterton, New Zealand
    
    Opening Hours
    
    Monday – Saturday // 7.30am – 2.00pm
    Sunday // Closed
    
    Contact
    06 379 5333
    info@theclarevillebakery.co.nz, Need to be able to include colour scheme to update colours. Plus should only be page width, not full width., Needs to be able to choose between full width and page width. Page width is based on Dawn Theme settings.

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-info-section-{{ ai_gen_id }} {
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-info-container-{{ ai_gen_id }} {
    {% if block.settings.container_width == 'page' %}
      max-width: {{ settings.page_width }}px;
      margin: 0 auto;padding: 0 {{ settings.spacing_grid_horizontal }}px;
    {% else %}
      padding: 0 {{ settings.spacing_grid_horizontal }}px;
    {% endif %}
  }

  .ai-info-columns-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: {{ block.settings.column_gap }}px;
    max-width: 100%;
  }

  .ai-info-column-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    {% if block.settings.text_alignment == 'center' %}
      align-items: center;
      text-align: center;
    {% elsif block.settings.text_alignment == 'right' %}
      align-items: flex-end;
      text-align: right;
    {% else %}
      align-items: flex-start;
      text-align: left;
    {% endif %}
    gap: {{ block.settings.content_gap }}px;
  }

  .ai-info-icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    background-color: {{ block.settings.icon_color }};
    border-radius: {{ block.settings.icon_border_radius }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: {{ block.settings.icon_text_color }};
    flex-shrink: 0;
  }

  .ai-info-icon-{{ ai_gen_id }} svg {
    width: {{ block.settings.icon_size | times: 0.6 }}px;
    height: {{ block.settings.icon_size | times: 0.6 }}px;
  }

  .ai-info-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 600;
    margin: 0;
    line-height: 1.2;
  }

  .ai-info-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.5;
    margin: 0;
    white-space: pre-line;
  }

  @media screen and (max-width: 749px) {
    .ai-info-columns-{{ ai_gen_id }} {
      grid-template-columns: 1fr;gap: {{ block.settings.mobile_gap }}px;
    }
    .ai-info-column-{{ ai_gen_id }} {
      {% if block.settings.mobile_alignment == 'center' %}
        align-items: center;
        text-align: center;
      {% elsif block.settings.mobile_alignment == 'right' %}
        align-items: flex-end;
        text-align: right;
      {% else %}
        align-items: flex-start;
        text-align: left;
      {% endif %}
    }
  }
{% endstyle %}

<div class="ai-info-section-{{ ai_gen_id }} color-{{ block.settings.color_scheme }}" {{ block.shopify_attributes }}>
  <div class="ai-info-container-{{ ai_gen_id }}">
    <div class="ai-info-columns-{{ ai_gen_id }}"><div class="ai-info-column-{{ ai_gen_id }}">
        <div class="ai-info-icon-{{ ai_gen_id }}">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
            <circle cx="12" cy="10" r="3"/>
          </svg>
        </div>
        <h3 class="ai-info-heading-{{ ai_gen_id }}">{{ block.settings.column_1_heading }}</h3>
        <div class="ai-info-text-{{ ai_gen_id }}">{{ block.settings.column_1_text }}</div>
      </div>

      <div class="ai-info-column-{{ ai_gen_id }}">
        <div class="ai-info-icon-{{ ai_gen_id }}">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/>
            <polyline points="12,6 12,12 16,14"/>
          </svg>
        </div>
        <h3 class="ai-info-heading-{{ ai_gen_id }}">{{ block.settings.column_2_heading }}</h3>
        <div class="ai-info-text-{{ ai_gen_id }}">{{ block.settings.column_2_text }}</div>
      </div>

      <div class="ai-info-column-{{ ai_gen_id }}">
        <div class="ai-info-icon-{{ ai_gen_id }}">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
        </div>
        <h3 class="ai-info-heading-{{ ai_gen_id }}">{{ block.settings.column_3_heading }}</h3>
        <div class="ai-info-text-{{ ai_gen_id }}">{{ block.settings.column_3_text }}</div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Three column info",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "container_width",
      "label": "Container width",
      "options": [
        {
          "value": "page",
          "label": "Page width"
        },
        {
          "value": "full",
          "label": "Full width"
        }
      ],
      "default": "page"
    },
    {
      "type": "header",
      "content": "Column 1"
    },
    {
      "type": "text",
      "id": "column_1_heading",
      "label": "Heading",
      "default": "Address"
    },
    {
      "type": "textarea",
      "id": "column_1_text",
      "label": "Text",
      "default": "High Street, Clareville\nCarterton, New Zealand"
    },
    {
      "type": "header",
      "content": "Column 2"
    },
    {
      "type": "text",
      "id": "column_2_heading",
      "label": "Heading",
      "default": "Opening Hours"
    },
    {
      "type": "textarea",
      "id": "column_2_text",
      "label": "Text",
      "default": "Monday – Saturday // 7.30am – 2.00pm\nSunday // Closed"
    },
    {
      "type": "header",
      "content": "Column 3"
    },
    {
      "type": "text",
      "id": "column_3_heading",
      "label": "Heading",
      "default": "Contact"
    },
    {
      "type": "textarea",
      "id": "column_3_text",
      "label": "Text",
      "default": "06 379 5333\ninfo@theclarevillebakery.co.nz"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "mobile_alignment",
      "label": "Mobile alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Column spacing",
      "min": 10,
      "max": 80,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "mobile_gap",
      "label": "Mobile spacing",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "content_gap",
      "label": "Content spacing",
      "min": 5,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Section padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "Icons"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 30,
      "max": 80,
      "step": 5,
      "unit": "px",
      "default": 50
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "icon_text_color",
      "label": "Icon color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "icon_border_radius",
      "label": "Icon border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 14,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Text size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    }
  ],
  "presets": [
    {
      "name": "Three column info"
    }
  ],
  "tag": null,
  "class": "three-column-info"
}
{% endschema %}