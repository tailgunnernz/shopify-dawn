{% assign show = true %}
{% if collection.title contains 'AGENTS PORTAL' %}
  {% assign show = false %}
{% endif %}
{% if show == true and request.design_mode == false or section.settings.preview == true %}
  {{ "custom-popup.css" | asset_url | stylesheet_tag }}
  <script src="{{ 'js-cookie.min.js' | asset_url }}" defer></script>
  <script src="{{ 'custom-popup.js' | asset_url }}" defer></script>
  
  {%- liquid
    assign show_interests = false
    if section.settings.show_interests and section.blocks.size > 0
      assign show_interests = true
    endif
  -%}

  <div id="customNewsletter" {% if show_interests %}class="has-interests"{% endif %}>
    <!--PRIVATE PAGE:{{ private_page }} -->
      <div class="customNewsletter__container">
        <div class="customNewsletter__bar">
          <button id="customNewsletter__close" aria-label="Close">X</button>
        </div>
        <div class="customNewsletter__logo">
          <img src="{{ section.settings.logo | img_url: 'master' }}" alt="Newsletter Image" />
        </div>
        <div class="customNewsletter__text">
        {% form 'customer', class: 'custom__newsletter-form' %}
          {%- unless form.posted_successfully? -%}
          <h2 class="h1">{{ section.settings.heading }}</h2>
          <p>{{ section.settings.paragraph }}</p>
              
              <input type="hidden" name="contact[tags]" value="newsletter">

              {%- if show_interests -%}
                <fieldset class="customNewsletter__interests">
                  <legend class="customNewsletter__interests-title">{{ section.settings.interests_heading }}</legend>
                  {%- if section.settings.interests_subheading != blank -%}
                    <p class="customNewsletter__interests-subtitle">{{ section.settings.interests_subheading }}</p>
                  {%- endif -%}
                  <ul class="customNewsletter__interests-list" role="list">
                    {%- for block in section.blocks -%}
                      {%- liquid
                        assign label = block.settings.text | default: block.settings.label | strip
                        if label == blank
                          continue
                        endif
                        if block.settings.tag != blank
                          assign tag = block.settings.tag | handleize
                        else
                          assign tag = label | handleize | prepend: 'interest-'
                        endif
                      -%}
                      <li {{ block.shopify_attributes }}>
                        <input
                          type="checkbox"
                          class="customNewsletter__interest-input"
                          id="Interest-{{ block.id }}"
                          data-interest-tag="{{ tag }}"
                          value="{{ tag }}"
                        >
                        <label class="customNewsletter__interest-label" for="Interest-{{ block.id }}">
                          {{ label }}
                        </label>
                      </li>
                    {%- endfor -%}
                  </ul>
                </fieldset>
              {%- endif -%}

              <div class="newsletter-form__field-wrapper">
                <div class="field">
                  <input
                    id="NewsletterForm--{{ section.id }}"
                    type="email"
                    name="contact[email]"
                    class="field__input"
                    value="{{ form.email }}"
                    aria-required="true"
                    autocorrect="off"
                    autocapitalize="off"
                    autocomplete="email"
                    {% if form.errors %}
                      autofocus
                      aria-invalid="true"
                      aria-describedby="Newsletter-error--{{ section.id }}"
                    {% elsif form.posted_successfully? %}
                      aria-describedby="Newsletter-success--{{ section.id }}"
                    {% endif %}
                    placeholder="{{ 'newsletter.label' | t }}"
                    required
                  >
                  <label class="field__label" for="NewsletterForm--{{ section.id }}">
                    {{ 'newsletter.label' | t }}
                  </label>
                  <button type="submit" class="newsletter-form__button field__button" name="commit" id="Subscribe" aria-label="{{ 'newsletter.button_label' | t }}">
                    {% render 'icon-arrow' %}
                  </button>
                </div>
                {%- if form.errors -%}
                  <small class="newsletter-form__message form__message" id="Newsletter-error--{{ section.id }}">{% render 'icon-error' %}{{ form.errors.translated_fields['email'] | capitalize }} {{ form.errors.messages['email'] }}</small>
                {%- endif -%}
                <p style="font-size:13px; text-align: center; color: #aaa">By submitting this form you accept our Terms & Conditions, and allow us to send marketing emails to your email address.</p>
                
              </div>
              {% endunless %}
              {%- if form.posted_successfully? -%}
                <h3 class="newsletter-form__message newsletter-form__message--success h1" id="Newsletter-success--{{ section.id }}" tabindex="-1" autofocus>{% render 'icon-success' %} {{ section.settings.headingSuccess }}</h3>
                <p>{{ section.settings.paragraphSuccess }}</p>
              {%- endif -%}
            {% endform %}

        </div>
      </div>
    </div>
{% endif %}

{% schema %}
  {
    "name": "Pop Up",
    "enabled_on": {
      "groups": ["footer"]
    },
    "settings": [
          {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo",
        "info": "Logo goes here"
      },
      {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "Heading Here",
        "placeholder": "Place Your Heading Here",
        "info": "Header for your popup"
      },
      {
        "type": "textarea",
        "id": "paragraph",
        "label": "Paragraph",
        "default": "Tell your customer why they should subscribe.",
        "placeholder": "Subscribe now to hear about great deals!",
        "info": "Paragraph area for pop up"
      },
      {
        "type": "text",
        "id": "headingSuccess",
        "label": "Heading (Success)",
        "default": "Thank You!",
        "placeholder": "Thank You!",
        "info": "Header for your popup"
      },
      {
        "type": "textarea",
        "id": "paragraphSuccess",
        "label": "Paragraph (Success)",
        "default": "Information displayed on successful subscription",
        "placeholder": "Subscribe now to hear about great deals!",
        "info": "Paragraph area for pop up"
      },
      {
        "type": "header",
        "content": "Product interests"
      },
      {
        "type": "checkbox",
        "id": "show_interests",
        "label": "Show interest checkboxes",
        "default": true
      },
      {
        "type": "text",
        "id": "interests_heading",
        "label": "Interests heading",
        "default": "What products are you interested in?"
      },
      {
        "type": "text",
        "id": "interests_subheading",
        "label": "Interests subheading",
        "default": "Select all that apply."
      },
      {
        "type": "checkbox",
        "id": "preview",
        "label": "Preview in Customiser",
        "default": true
      }
    ],
    "blocks": [
      {
        "type": "interest",
        "name": "Interest option",
        "settings": [
          {
            "type": "text",
            "id": "text",
            "label": "Label",
            "info": "Shown next to the checkbox"
          },
          {
            "type": "text",
            "id": "tag",
            "label": "Customer tag",
            "info": "Optional. Leave blank and the tag is built from the label — \"Country Flags\" becomes interest-country-flags. Renaming a label changes the tag, so existing customers keep the old one."
          }
        ]
      }
    ],
    "max_blocks": 25,
    "presets": [
      {
        "name": "Pop Up",
        "blocks": [
          {
            "type": "interest",
            "settings": {
              "text": "Country Flags"
            }
          },
          {
            "type": "interest",
            "settings": {
              "text": "New Zealand Flags"
            }
          },
          {
            "type": "interest",
            "settings": {
              "text": "Flagpoles"
            }
          },
          {
            "type": "interest",
            "settings": {
              "text": "Teardrop & Feather Flags"
            }
          },
          {
            "type": "interest",
            "settings": {
              "text": "RollUp Banners"
            }
          },
          {
            "type": "interest",
            "settings": {
              "text": "Licensed Sport Products"
            }
          },
          {
            "type": "interest",
            "settings": {
              "text": "Event & Promotional Products"
            }
          },
          {
            "type": "interest",
            "settings": {
              "text": "Streetflags & Flagtrax Flags"
            }
          },
          {
            "type": "interest",
            "settings": {
              "text": "Real Estate Flags"
            }
          }
        ]
      }
    ]
  }
{% endschema %}


